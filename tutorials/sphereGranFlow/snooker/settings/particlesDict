setFields
{
    /*
        Default value for fields defined for particles:

        These fields should always be defined for simulations with spherical particles
    */
    defaultValue 
    {
        velocity        realx3 (0 0 0);     // linear velocity (m/s)

        acceleration    realx3 (0 0 0);     // linear acceleration (m/s2)

        rVelocity       realx3 (0 0 0);     // rotational velocity (rad/s)

        shapeName       word  red;     // name of the particle shape 
    }

    selectors
    {
        // white ball
        velocityAssigne
        {
            selector           stridedRange;      
            stridedRangeInfo
            {
                begin         21; // begin index of points
                end           22; // end index of points 
                stride        1;  // stride for selector 
            }
            fieldValue
            {
                shapeName       word  white;     // name of the ball
                velocity        realx3 (-6 0.5 0);   // linear velocity (m/s)
                rVelocity       realx3 (-1 0 0); // rotational velocity (rad/s)
            }
        }
        

        shapeAssigne1
        {
            selector           stridedRange;      
            stridedRangeInfo
            {
                begin       20;    // begin index of points
                end         21;    // end index of points 
                stride      1;    // stride for selector 
            }
            fieldValue                            
            {
                shapeName       word  blue;
            }
        }

        shapeAssigne2
