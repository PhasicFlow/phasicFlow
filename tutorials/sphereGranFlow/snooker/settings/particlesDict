                shapeName       word  pink;     // name of the particle shape --- assigns the shape "brown" to the selected particles
            }
        }
    }
}

positionParticles                                // positions particles 
{
    method        file;                       // other options: random and empty
    
    fileInfo
    {       
        name    position.csv;                     

        commaSeparated Yes;                  
