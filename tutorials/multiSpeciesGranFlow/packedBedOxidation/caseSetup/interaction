objectName interaction;
objectType dictionary;
fileFormat ASCII;
/*---------------------------------------------------------------------------*/

materials   (carrierMaterial wallMaterial);     // a list of materials names

// carrier: apparent density of the fully reduced Fe45Al-FG, 3257 kg/m3
// (Abad et al. 2007, Table 2) times the mass ratio 0.985 of the reduced
// particle, same particle volume. With enableShrinking No the particle
// mass follows the reaction while the diameter stays fixed.
// wall: Kanthal APMT datasheet.
densities   (3208 7250);                        // [kg/m3]

// Real (unsoftened) mechanical properties, read by the thermal model for
// the contact-radius correction. Carrier: no measured value is known for
// the porous particle; 1.0e9 Pa and 0.3 are the values of the thermal
// tutorials. Wall: Kanthal APMT datasheet, 140 GPa at 900 C.
realYoungsModuli   (1.0e9 1.4e11);             // [Pa]
poissonRatios       (0.3 0.3);                  // [-]

contactListType   sortedContactList;

contactSearch
{
    method          NBS;                        // method for broad search
    updateInterval   10;
    sizeRatio       1.1;
    cellExtent     0.55;
    adjustableBox   Yes;
}

model
{
    contactForceModel    nonLinearLimited;
    rollingFrictionModel normal;

    Yeff (1.0e6 1.0e6                           // Young modulus [Pa]
                1.0e6);

    Geff (0.8e6 0.8e6                           // Shear modulus [Pa]
                0.8e6);

    nu   (0.25 0.25                             // Poisson's ratio [-]
               0.25);

    en   (0.97 0.97                             // coefficient of normal restitution
               0.97);

    mu   (0.65 0.65                             // dynamic friction
               0.65);

    mur  (0.1 0.1                               // rolling friction
              0.1);
}
